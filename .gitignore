# ==============================================================================
# DOCrag .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Secret Configuration
# ------------------------------------------------------------------------------
.env
.env*.local
**/.env
**/.env*.local
!.env.example
!frontend/.env.example
!backend/.env.example

# ------------------------------------------------------------------------------
# 2. Python & Backend Environment
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# 3. Frontend (Next.js / Node / Tailwind)
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
.npm
*.tsbuildinfo
next-env.d.ts

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 4. Retrieval Storage, Indexing & Uploads
# ------------------------------------------------------------------------------
chroma_db/
chroma_data/
**/chroma_db/
**/chroma_data/
*.pkl
bm25_index.pkl
**/bm25_index.pkl

# Uploaded documents (preserve repository test fixtures only)
backend/uploads/*
!backend/uploads/test.pdf
!backend/uploads/test_upload.pdf
!backend/uploads/.gitkeep

# ------------------------------------------------------------------------------
# 5. Model Training & Large Binary Weights
# ------------------------------------------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/
checkpoint-*/
runs/

# Large Language Model Weights (Exceed GitHub 100MB limit)
*.gguf
*.part
*.safetensors
*.bin
*.ckpt
*.pt
*.pth
*.onnx

# ------------------------------------------------------------------------------
# 6. Operating System & Editor Artifacts
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
**/.DS_Store

# IDE & Editor settings
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*.sublime-workspace
*.sublime-project
