# ==============================================================================
# Ollama Modelfile: Grounded RAG Llama-3-8B (4-bit Q4_K_M)
# ==============================================================================

# Path to the exported GGUF artifact generated by Unsloth
FROM ./llama-3-8b-Instruct.Q4_K_M.gguf

# Generation Parameters for Strict Factuality & Determinism
PARAMETER temperature 0.0
PARAMETER top_p 0.9
PARAMETER top_k 40
PARAMETER num_ctx 4096
PARAMETER repeat_penalty 1.1

# Stop Tokens for Meta Llama-3 Chat Template
PARAMETER stop "<|start_header_id|>"
PARAMETER stop "<|end_header_id|>"
PARAMETER stop "<|eot_id|>"
PARAMETER stop "<|end_of_text|>"

# Native Meta Llama-3 Chat Template Format
TEMPLATE """{{ if .System }}<|start_header_id|>system<|end_header_id|>

{{ .System }}<|eot_id|>{{ end }}{{ if .Prompt }}<|start_header_id|>user<|end_header_id|>

{{ .Prompt }}<|eot_id|>{{ end }}<|start_header_id|>assistant<|end_header_id|>

{{ .Response }}<|eot_id|>"""

# Strict Grounded RAG System Prompt
SYSTEM """Answer the user query based ONLY on the provided context. Do not extrapolate, assume, or use prior knowledge. If the answer cannot be determined strictly from the context, reply with: "Information not found." """
