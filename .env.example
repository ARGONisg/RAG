# ─────────────────────────────────────────────────────────────────────────────
# RAG System Configuration Template (.env.example)
# Duplicate this file to .env and adjust variables to match your environment.
# ─────────────────────────────────────────────────────────────────────────────

# =============================================================================
# 1. LLM Serving / Model Endpoint
# =============================================================================
# ngrok (permanent link): https://<your-subdomain>.ngrok-free.dev/v1
# Local Ollama: http://localhost:11434/v1
# Cloudflare: https://<your-subdomain>.trycloudflare.com/v1
LLM_BASE_URL=https://undertone-gorged-fancy.ngrok-free.dev/v1
LLM_API_KEY=ollama
LLM_MODEL_NAME=hf.co/chaitanya-rathi/llama-3-8b-rag-grounded:Q4_K_M
USE_MOCK_LLM=false

# =============================================================================
# 2. Retrieval & Vector Store Configuration
# =============================================================================
USE_MOCK_RETRIEVAL=false
CHROMA_PERSIST_DIR=./chroma_db
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
SIMILARITY_THRESHOLD=0.0
TOP_K_CHUNKS=4

# =============================================================================
# 3. Backend Server & File Uploads
# =============================================================================
UPLOAD_DIR=./uploads
CORS_ORIGIN=http://localhost:3000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# =============================================================================
# 4. Frontend Configuration (Next.js)
# =============================================================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
